@page "/"
@rendermode InteractiveServer
@inject Services.AppSettings Settings
@inject NavigationManager NavigationManager


<PageTitle>@Settings.ApplicationName</PageTitle>

<div class="landing-container">
    <div class="landing-content text-center">
        <div class="hero-container">
            <h1 class="title">INGRID BZ — FIELD SERVICE PORTAL</h1>
            <h2 class="subtitle">
                ACCESS <span class="highlight">YOUR TOOLS</span> NOW!
            </h2>

            <button class="btn btn-blue" @onclick="Login">Login</button>
        </div>
    </div>
</div>

@code
{
    private void Login()
    {
        NavigationManager.NavigateTo("/login");
    }    
}